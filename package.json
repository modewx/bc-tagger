{
  "name": "bc-tagger",
  "version": "0.1.0",
  "description": "Bandcamp tagger: Chrome extension, shared collection UI, local app",
  "private": true,
  "scripts": {
    "build": "webpack --mode=production --config extension/config/webpack.config.js",
    "build:dev": "webpack --mode=development --env dev --config extension/config/webpack.config.js",
    "watch:dev": "webpack --mode=development --env dev --watch --config extension/config/webpack.config.js",
    "build:app": "webpack --mode=production --config app/config/webpack.config.js",
    "watch:app": "webpack --mode=development --watch --config app/config/webpack.config.js",
    "build:all": "npm run build && npm run build:dev && npm run build:app",
    "pack": "node extension/pack.js",
    "repack": "npm run build && npm run pack",
    "format": "prettier --write --ignore-unknown \"{extension,shared,app}/**/*.{html,css,js,ts,json}\""
  },
  "devDependencies": {
    "adm-zip": "^0.5.10",
    "copy-webpack-plugin": "^10.2.4",
    "css-loader": "^6.8.1",
    "file-loader": "^6.2.0",
    "mini-css-extract-plugin": "^2.7.6",
    "prettier": "^2.8.8",
    "webpack": "^5.88.2",
    "webpack-cli": "^4.10.0",
    "webpack-merge": "^5.9.0"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12"
  }
}
