{
  "manifest_version": 3,
  "name": "Bc Tagger",
  "version": "0.1.0",
  "description": "My Chrome Extension",
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bc Tagger",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "webRequest",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://*.bandcamp.com/*",
    "http://*.bandcamp.com/*",
    "https://bandcamp.com/*",
    "http://bandcamp.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bandcamp.com/*",
        "http://*.bandcamp.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "jquery_2.1.1_jquery.min.js",
        "chosen_1.8.7.min.js",
        "contentScript.js"
      ],
      "css": [
        "chosen.min.css",
        "tagger.css"
      ]
    },
    {
      "matches": [
        "https://*.bandcamp.com/cart/checkout*",
        "http://*.bandcamp.com/cart/checkout*",
        "https://*.paypal.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "checkout.js"
      ]
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "run_at": "document_start",
      "js": [
        "appBridge.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "jquery_2.1.1_jquery.min.js",
        "chosen_1.8.7.min.js",
        "taggerTemplate.html",
        "chosen-sprite@2x.png",
        "chosen-sprite.png",
        "tags.json"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}
